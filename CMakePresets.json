{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "displayName": "Base",
      "binaryDir": "${sourceDir}/build",
      "hidden": true
    },
    {
      "name": "make",
      "displayName": "Unix Makefiles Debug",
      "description": "Debug configuration using Make and vcpkg",
      "generator": "Unix Makefiles",
      "inherits": [
        "base"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "make-release",
      "displayName": "Unix Makefiles Release",
      "description": "Release configuration using Make and vcpkg",
      "generator": "Unix Makefiles",
      "inherits": [
        "base"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-vs",
      "displayName": "Visual Studio",
      "description": "Configuration using default available Visual Studio / MSVC",
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs-debug",
      "displayName": "Visual Studio / MSVC Debug",
      "configurePreset": "windows-vs",
      "configuration": "Debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "vs-release",
      "displayName": "Visual Studio / MSVC Release",
      "configurePreset": "windows-vs",
      "configuration": "Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ]
}